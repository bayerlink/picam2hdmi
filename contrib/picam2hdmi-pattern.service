# picam2hdmi as an appliance: power on, it streams. Install:
#   sudo cp picam2hdmi-pattern.service /etc/systemd/system/
#   sudo systemctl enable --now picam2hdmi-pattern
#
# This is the phase-0 unit (test pattern, no camera). The camera unit will
# be its sibling when capture lands. Needs a KMS-capable stack (Pi OS Lite,
# vc4-kms-v3d) and NO desktop session owning the display -- the whole point
# is that nothing else touches the connector.
[Unit]
Description=bayerlink test-pattern source over HDMI
After=multi-user.target

[Service]
ExecStart=/usr/bin/picam2hdmi stream --source pattern --pattern counting \
    --width 2028 --height 1078 --bayer RGGB --mode 1920x1080@30
Restart=always
RestartSec=2
# DRM master needs either root or the 'video' group.
User=root

[Install]
WantedBy=multi-user.target
