# The genlocked camera bridge as a bench fixture: power on, the
# sensor streams line-locked to the HDMI output, forever. Runs
# through the CLI so the binary is ALWAYS the package's C source
# plus whatever modules are installed -- the compiled-in seam the
# panel's module uploads feed. Install:
#   sudo cp bridge.service /etc/systemd/system/
#   sudo systemctl enable --now bridge
#
# Supervised, not bounded: the bench rule is that nothing runs
# unwatched, and a supervisor satisfies it better than a timer -- a
# bounded run ends by design at the worst possible hour, while a
# supervised one restarts on any exit and keeps testifying (the
# bridge prints its soak verdict hourly under a supervisor, since
# there is no exit to print it at). journald owns the log rotation.
[Unit]
Description=bayerlink camera bridge (sensor-genlocked HDMI source)
After=multi-user.target

[Service]
ExecStart=/usr/local/bin/picam2hdmi bridge --gain 200
Restart=always
RestartSec=2
# KMS master and V4L2 subdev access need root on a stock Pi OS Lite.
User=root

[Install]
WantedBy=multi-user.target
